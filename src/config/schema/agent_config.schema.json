{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/agent_config.schema.json",
  "title": "AgentConfig",
  "type": "object",
  "required": ["name", "llm", "workflow", "prompts"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "llm": { "type": "object" },
    "workflow": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "human_in_loop": { "type": "string" }
      },
      "additionalProperties": true
    },
    "prompts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "additionalProperties": true
}